@page "/create-issue"
@using IU2.Core.Services
@using IU2.Core.Models
@rendermode InteractiveServer
@inject IIssueService IssueService

<div style="min-height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 40px 20px; display: flex; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 12px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); padding: 40px; width: 100%; max-width: 600px;">

        <div style="margin-bottom: 30px;">
            <h1 style="font-size: 32px; font-weight: 700; color: #1a1a1a; margin: 0 0 8px 0;">Skapa nytt Issue</h1>
            <p style="color: #666; margin: 0; font-size: 14px;">Fyll i detaljer för det nya issue:t</p>
        </div>

        <EditForm Model="@newIssue" OnValidSubmit="@HandleSubmit">
            <DataAnnotationsValidator />

            <div style="margin-bottom: 20px;">
                <label for="title" style="display: block; font-weight: 600; color: #333; margin-bottom: 8px; font-size: 14px;">Titel *</label>
                <InputText id="title" style="width: 100%; padding: 12px 16px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 14px;" @bind-Value="newIssue.Title" placeholder="Ex. Login fungerar inte..." />
                <ValidationMessage For="@(() => newIssue.Title)" style="color: #e74c3c; font-size: 13px;" />
            </div>

            <div style="margin-bottom: 20px;">
                <label for="category" style="display: block; font-weight: 600; color: #333; margin-bottom: 8px; font-size: 14px;">Kategori *</label>
                <InputSelect id="category" style="width: 100%; padding: 12px 16px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 14px;" @bind-Value="newIssue.Category">
                    <option value="">-- Välj kategori --</option>
                    @foreach (var category in Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => newIssue.Category)" style="color: #e74c3c; font-size: 13px;" />
            </div>

            <div style="margin-bottom: 20px;">
                <label for="assignee" style="display: block; font-weight: 600; color: #333; margin-bottom: 8px; font-size: 14px;">Användare *</label>
                <InputSelect id="assignee" style="width: 100%; padding: 12px 16px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 14px;" @bind-Value="newIssue.Username">
                    <option value="">-- Välj användare --</option>
                    @foreach (var user in MockUsers)
                    {
                        <option value="@user.Name">@user.Name (@user.Email)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => newIssue.Username)" style="color: #e74c3c; font-size: 13px;" />
            </div>

            <div style="margin-bottom: 28px;">
                <label for="description" style="display: block; font-weight: 600; color: #333; margin-bottom: 8px; font-size: 14px;">Beskrivning *</label>
                <InputTextArea id="description" style="width: 100%; padding: 12px 16px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 14px; min-height: 120px;" @bind-Value="newIssue.Description" placeholder="Beskiv problemet eller önskemålet i detalj..." rows="4" />
                <ValidationMessage For="@(() => newIssue.Description)" style="color: #e74c3c; font-size: 13px;" />
            </div>

            <div style="display: flex; gap: 12px;">
                <button type="submit" style="flex: 1; padding: 12px 24px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;">
                    ✓ Skapa Issue
                </button>
                <a href="/issues" style="padding: 12px 24px; background: #f0f0f0; color: #333; text-decoration: none; border-radius: 8px; font-size: 16px; font-weight: 600; display: flex; align-items: center; justify-content: center;">
                    ← Tillbaka
                </a>
            </div>
        </EditForm>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="margin-top: 20px; padding: 16px; background: #d4edda; color: #155724; border-radius: 8px;">
                ✓ @successMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="margin-top: 20px; padding: 16px; background: #f8d7da; color: #721c24; border-radius: 8px;">
                ✕ @errorMessage
            </div>
        }
    </div>
</div>

@code {
    private Issue newIssue = new();
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    private readonly List<string> Categories = new()
    {
        "Bug",
        "Feature",
        "Enhancement",
        "Documentation",
        "Question"
    };

    private readonly List<MockUser> MockUsers = new()
    {
        new MockUser { Id = "1", Name = "Anna Andersson", Email = "anna@example.com" },
        new MockUser { Id = "2", Name = "Bob Bergström", Email = "bob@example.com" },
        new MockUser { Id = "3", Name = "Clara Carlsson", Email = "clara@example.com" },
        new MockUser { Id = "4", Name = "David Davidsson", Email = "david@example.com" },
        new MockUser { Id = "5", Name = "Eva Eriksson", Email = "eva@example.com" }
    };

    private async Task HandleSubmit()
    {
        try
        {
            var issue = new Issue
            {
                Title = newIssue.Title,
                Description = newIssue.Description,
                Category = newIssue.Category,
                Username = newIssue.Username
            };

            await IssueService.CreateAsync(issue);

            successMessage = "Issue sparades framgångsrikt!";
            errorMessage = string.Empty;
            newIssue = new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Fel vid sparning: {ex.Message}";
            successMessage = string.Empty;
        }
    }



    private class MockUser
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }
}
