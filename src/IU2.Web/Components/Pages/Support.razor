@page "/support"
@rendermode InteractiveServer

@using IU2.Core.Models
@inject IU2.Core.Services.IIssueService IssueService

<h3>Inkomna felanmälningar</h3>

@if (issues == null)
{
    <p>Laddar...</p>
}
else if (issues.Count == 0)
{
    <p>Det finns inga felanmälningar.</p>
}
else
{
    @if (meddelande != null)
    {
        <p class="@meddelandeKlass">@meddelande</p>
    }
    <table class="table">

        <thead>
            <tr>
                <th>Id</th>
                <th>Rubrik</th>
                <th>Kategori</th>
                <th>Status</th>
                <th>Skapad</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var issue in issues)
            {
                <tr>
                    <td>@issue.Id</td>

                    <td>
                        <a href="/issue/@issue.Id">
                            @issue.Title
                        </a>
                    </td>

                    <td>
                        <select class="form-select form-select-sm" value="@issue.Category"
                                @onchange="e => SparaKategori(issue, e)">
                            @foreach (var kategori in Enum.GetValues<IssueCategory>())
                            {
                                <option value="@kategori">@kategori</option>
                            }
                        </select>
                    </td>

                    <td>@issue.Status.TillSvenska()</td>

                    <td>@issue.CreatedAt</td>
                </tr>
            }

        </tbody>

    </table>
}

@code {

    private List<Issue>? issues;

    protected override async Task OnInitializedAsync()
    {
        issues = await IssueService.GetAllAsync();
    }

    private string? meddelande;
    private string meddelandeKlass = "text-success";

    private async Task SparaKategori(Issue issue, ChangeEventArgs e)
    {
        var nyKategori = Enum.Parse<IssueCategory>(e.Value!.ToString()!);

        var sparades = await IssueService.UpdateCategoryAsync(issue.Id, nyKategori);

        if (sparades)
        {
            issue.Category = nyKategori;
            meddelandeKlass = "text-success";
            meddelande = $"Kategori sparad för ärende {issue.Id}: {nyKategori}";
        }
        else
        {
            meddelandeKlass = "text-danger";
            meddelande = $"Kunde inte spara. Ärende {issue.Id} finns inte längre.";
        }
    }
}
